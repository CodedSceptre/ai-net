{
  "uid": "stellar-payments",
  "title": "Stellar Payments",
  "tags": [
    "ai-net"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "name": "Threshold breaches",
        "enable": true,
        "hide": false,
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "iconColor": "red",
        "filter": {
          "exclude": false,
          "ids": [
            2
          ]
        },
        "expr": "ALERTS{alertname=\"StellarPaymentFailureThresholdExceeded\",alertstate=\"firing\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{description}}",
        "tagKeys": "severity",
        "target": {
          "expr": "ALERTS{alertname=\"StellarPaymentFailureThresholdExceeded\",alertstate=\"firing\"}",
          "step": "30s",
          "titleFormat": "{{alertname}}",
          "textFormat": "{{description}}",
          "tagKeys": "severity",
          "refId": "A"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current payment failures per minute",
      "description": "Estimated failed Stellar payment operations per minute using a two-minute window. Red indicates more than three failures per minute.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3.0000000000000004
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(rate(stellar_payment_failures_total[2m])) * 60",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Payment failure rate and threshold",
      "description": "History of failed Stellar payment operations per minute. Annotations mark breaches of the three-per-minute threshold.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3.0000000000000004
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(rate(stellar_payment_failures_total[2m])) * 60",
          "refId": "A",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "XLM locked per hour",
      "description": "Total XLM locked by successful Stellar payment operations in each rolling hour.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(increase(stellar_payment_xlm_locked_total[1h]))",
          "refId": "A",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "XLM released per hour",
      "description": "Total XLM released by successful Stellar payment operations in each rolling hour.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(increase(stellar_payment_xlm_released_total[1h]))",
          "refId": "A",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "XLM refunded per hour",
      "description": "Total XLM refunded by successful Stellar payment operations in each rolling hour.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(increase(stellar_payment_xlm_refunded_total[1h]))",
          "refId": "A",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Failed payments",
      "description": "Number of failed Stellar payment operations in each rolling five-minute window.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(increase(stellar_payment_failures_total[5m]))",
          "refId": "A",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Average payment release latency",
      "description": "Average time spent executing successful Stellar releases over the last five minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(rate(stellar_payment_release_duration_seconds_sum[5m])) / sum(rate(stellar_payment_release_duration_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "",
          "range": true
        }
      ]
    }
  ]
}
