{
  "uid": "api-health",
  "title": "API Health",
  "tags": [
    "ai-net"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "name": "Threshold breaches",
        "enable": true,
        "hide": false,
        "datasource": {
          "type": "prometheus",
          "uid": "DS_PROMETHEUS"
        },
        "iconColor": "red",
        "filter": {
          "exclude": false,
          "ids": [
            2
          ]
        },
        "expr": "ALERTS{alertname=\"ApiErrorThresholdExceeded\",alertstate=\"firing\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{description}}",
        "tagKeys": "severity",
        "target": {
          "expr": "ALERTS{alertname=\"ApiErrorThresholdExceeded\",alertstate=\"firing\"}",
          "step": "30s",
          "titleFormat": "{{alertname}}",
          "textFormat": "{{description}}",
          "tagKeys": "severity",
          "refId": "A"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current HTTP error rate",
      "description": "Percentage of responses with status 5xx over the last five minutes. Red indicates a breach of the 5% threshold.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5.000000000000001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "100 * ((sum(rate(http_requests_total{status=~\"5..\"}[5m])) or 0 * sum(rate(http_requests_total[5m]))) / sum(rate(http_requests_total[5m])))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP error rate and threshold",
      "description": "History of the API-wide five-minute HTTP 5xx response percentage. Annotations mark threshold breaches.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5.000000000000001
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "100 * ((sum(rate(http_requests_total{status=~\"5..\"}[5m])) or 0 * sum(rate(http_requests_total[5m]))) / sum(rate(http_requests_total[5m])))",
          "refId": "A",
          "legendFormat": "",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Requests per second by route",
      "description": "Five-minute average HTTP request rate by method and route template.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum by (route) (rate(http_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP error rate by route",
      "description": "Percentage of each route’s responses with status 5xx over the last five minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "100 * ((sum by (route) (rate(http_requests_total{status=~\"5..\"}[5m])) or 0 * sum by (route) (rate(http_requests_total[5m]))) / sum by (route) (rate(http_requests_total[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "p50 latency by route",
      "description": "Estimated 50th percentile response duration by route over the last five minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "p95 latency by route",
      "description": "Estimated 95th percentile response duration by route over the last five minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "p99 latency by route",
      "description": "Estimated 99th percentile response duration by route over the last five minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "range": true
        }
      ]
    }
  ]
}
